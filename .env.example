# Application
APP_NAME=price-comparison-pk
APP_ENV=development
DEBUG=true

# Frontend (Next.js)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend (FastAPI)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=price_comparison
POSTGRES_USER=price_user
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+asyncpg://price_user:change_me@localhost:5433/price_comparison

# Redis (queues / cache — workers later)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0
